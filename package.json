{
  "name": "@functorfactory/eslint-config",
  "version": "0.4.0",
  "description": "ESLint config for Functor Factory projects",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist/*",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prepare": "pnpm run clean && pnpm run build",
    "clean": "rimraf dist .tsbuildinfo",
    "update-version": "changeset version && pnpm install --no-frozen-lockfile",
    "build": "tsup",
    "check": "tsc -b tsconfig.json",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "pnpm run build && eslint .",
    "lint:fix": "pnpm run build && eslint . --fix"
  },
  "prettier": "@functorfactory/prettier-config",
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FunctorFactory/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/FunctorFactory/eslint-config/issues"
  },
  "homepage": "https://github.com/FunctorFactory/eslint-config",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "author": "Jake Shilling <jshilling@functorfactory.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@babel/helpers": "^7.28.3",
    "@changesets/cli": "^2.29.6",
    "@functorfactory/prettier-config": "^0.1.0",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-language-server": "^4.4.0"
  },
  "peerDependencies": {
    "eslint": "^9.34.0"
  },
  "dependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/utils": "^8.41.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-github": "^1.1.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-codegen": "^0.33.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jest-extended": "^3.0.0",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-jsdoc": "^57.1.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "typescript-eslint": "^8.41.0"
  }
}
